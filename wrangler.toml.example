# Configuração do Cloudflare Workers
# Copie este arquivo para wrangler.toml e ajuste os valores

name = "tcrb-monitoring"
main = "src/worker.js"
compatibility_date = "2024-01-01"

# Configuração de cron para execução periódica
# Executa a cada hora
[triggers]
crons = ["0 * * * *"]

# Variáveis de ambiente (opcional)
[vars]
ENVIRONMENT = "production"

# Configuração do D1 Database (Cloudflare)
# Descomente e configure após criar o banco no Cloudflare
# [[d1_databases]]
# binding = "DB"
# database_name = "tcrb-observations"
# database_id = "seu-database-id-aqui"